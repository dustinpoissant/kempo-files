# kempo-files peer-depends on both kempo and kempo-server directly, and kempo itself
# peer-depends on kempo-server too — a dual path to the same package that npm's strict
# peer resolver (npm 7+) rejects even though the version ranges genuinely overlap
# (kempo-files wants >=3.3.0, kempo wants >=3.1.4 — every version satisfying the first
# also satisfies the second). legacy-peer-deps sidesteps that false-positive rather than
# dropping the direct kempo-server peer dependency, which kempo-files genuinely needs on
# its own (serve-static-file) independent of whatever kempo needs it for.
legacy-peer-deps=true
